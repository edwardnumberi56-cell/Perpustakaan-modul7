APP_NAME=perpustakaan-modul7
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://perpustakaan-modul7-ten.vercel.app

PP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
BCRYPT_ROUNDS=12

# Log ke stderr agar terbaca di Vercel > Logs
LOG_CHANNEL=stderr
LOG_LEVEL=error

# Supabase PostgreSQL (Transaction Pooler)
# Salin dari Supabase > Connect > Transaction pooler
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.cwmglcdxfurxgxjgeecu
DB_PASSWORD=
DB_SSLMODE=require

# Session disimpan di tabel "sessions" (sudah ada di migration)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# JANGAN isi SESSION_DOMAIN (terutama jangan .vercel.app)
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=array
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log